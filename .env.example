# Neon PostgreSQL. Locally use the `dev` branch; on Vercel the Neon integration sets both variables.
# Pooled connection (host contains "-pooler"), used by the app:
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# Direct connection, used by Prisma CLI (migrate deploy / status):
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Generate with: npx @better-auth/cli secret  (or any random 32+ char string)
BETTER_AUTH_SECRET="replace-with-a-long-random-string"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
